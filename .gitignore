# environments
.venv/
__pycache__/
*.pyc

# model weights + converted GGUF — download with models/download-nllb-model.sh
# or regenerate with tools/convert_nllb_to_gguf.py. The download scripts and
# models/README.md are the only tracked files in models/.
models/*
!models/download-nllb-model.sh
!models/download-nllb-model.ps1
!models/README.md
*.gguf
*.gguf.part
dist/
*.safetensors
*.bin

# golden files — regenerate with tools/dump_reference.py
ref/
ref-*/
*.npz
*.npy

# build
build/
*.o
*.a
*.dylib

.DS_Store

*.tar.gz
*.tgz

# scratch from CLI runs — regenerate by re-running nllb-cli
output.txt
output-*.txt
log.txt
log-*.txt
build-apple/
build-ios-sim/
build-ios-device/
build-macos/
xcf.log
