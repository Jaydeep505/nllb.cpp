# environments
.venv/
__pycache__/
*.pyc

# model weights + converted GGUF — download with models/download-nllb-model.sh
# or regenerate with models/convert-nllb-to-gguf.py. Only the scripts,
# requirements and README are tracked in models/.
models/*
!models/download-nllb-model.sh
!models/download-nllb-model.ps1
!models/README.md
!models/convert-nllb-to-gguf.py
!models/requirements-convert.txt
*.gguf
*.gguf.part
dist/
*.safetensors
*.bin

# golden files — regenerate with scripts/dump_reference.py
ref/
ref-*/
*.npz
*.npy

# build
build/
*.o
*.a
*.dylib

.DS_Store

*.tar.gz
*.tgz

# scratch from CLI runs — regenerate by re-running nllb-cli
output.txt
output-*.txt
log.txt
log-*.txt
build-apple/
build-ios-sim/
build-ios-device/
build-macos/
xcf.log
